# ---- Server ----
PORT=3000
NODE_ENV=production
# Comma-separated list of allowed origins for CORS (your web/app origin)
CORS_ORIGINS=capacitor://localhost,http://localhost:5173

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# ---- Postgres ----
# When using docker-compose, host is the service name "db"
DATABASE_URL=postgres://proapp:proapp_password@db:5432/proapp

# ---- Google Sign-In ----
# OAuth Web client ID from Google Cloud Console
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# ---- Razorpay ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ---- Firebase Cloud Messaging (push) ----
# Path (inside the container) to the service-account JSON, OR leave blank to disable push
FIREBASE_SERVICE_ACCOUNT=/app/secrets/firebase-service-account.json

# ---- Economy tuning ----
SIGNUP_BONUS=10
DAILY_BONUS_BASE=5
DAILY_BONUS_MAX=15
TOOL_COST=1
SHARE_REWARD=2
